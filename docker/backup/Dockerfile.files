FROM python:3.11-slim

# 设置工作目录
WORKDIR /app

# 安装系统依赖
RUN apt-get update && apt-get install -y \
    curl \
    rsync \
    gzip \
    tar \
    openssl \
    inotify-tools \
    && rm -rf /var/lib/apt/lists/*

# 复制requirements文件
COPY requirements/backup.txt /app/requirements.txt

# 安装Python依赖
RUN pip install --no-cache-dir -r requirements.txt

# 复制备份脚本
COPY scripts/backup/file_backup.py /app/scripts/backup/
COPY config/backup/ /app/config/backup/

# 创建必要的目录
RUN mkdir -p /app/logs /app/backups /app/data /app/uploads

# 设置权限
RUN chmod +x /app/scripts/backup/file_backup.py

# 创建非root用户
RUN useradd -m -u 1000 backup && \
    chown -R backup:backup /app

# 切换到非root用户
USER backup

# 健康检查
HEALTHCHECK --interval=60s --timeout=10s --retries=3 \
    CMD curl -f http://localhost:8081/health || exit 1

# 暴露端口
EXPOSE 8081

# 默认命令
CMD ["python", "/app/scripts/backup/file_backup.py", "--config", "/app/config/backup/file_backup.json", "--sync"]