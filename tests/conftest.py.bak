# 测试标记
pytestmark = pytest.mark.asyncio


# 测试工具函数
def assert_response_success(response, expected_status=200):
    """断言响应成功"""
    assert response.status_code == expected_status
    assert "error" not in response.json()


def assert_response_error(response, expected_status=400):
    """断言响应错误"""
    assert response.status_code == expected_status
    response_data = response.json()
    assert "error" in response_data or "detail" in response_data


def assert_simulation_valid(simulation_data):
    """断言仿真数据有效"""
    required_fields = ["id", "name", "status", "created_at"]
    for field in required_fields:
        assert field in simulation_data
    
    assert simulation_data["status"] in ["created", "running", "completed", "failed", "paused"]


def assert_user_valid(user_data):
    """断言用户数据有效"""
    required_fields = ["id", "username", "email", "is_active"]
    for field in required_fields:
        assert field in user_data
    
    # 确保敏感信息不被暴露
    assert "password" not in user_data
    assert "hashed_password" not in user_data


async def create_test_simulation(db_session, user_id, **kwargs):
    """创建测试仿真的辅助函数"""
    default_data = {
        "name": "Test Simulation",
        "description": "Test Description",
        "config": {"duration": 100, "time_step": 0.1},
        "user_id": user_id,
        "status": "created"
    }
    default_data.update(kwargs)
    
    simulation = Simulation(**default_data)
    db_session.add(simulation)
    await db_session.commit()
    await db_session.refresh(simulation)
    
    return simulation


async def cleanup_test_data(db_session):
    """清理测试数据"""
    # 删除所有测试数据
    await db_session.execute("DELETE FROM simulations")
    await db_session.execute("DELETE FROM users")
    await db_session.commit()


# 性能测试辅助函数
class PerformanceTimer:
    """性能计时器"""
    
    def __init__(self):
        self.start_time = None
        self.end_time = None
    
    def start(self):
        import time
        self.start_time = time.time()
    
    def stop(self):
        import time
        self.end_time = time.time()
    
    @property
    def elapsed(self):
        if self.start_time and self.end_time:
            return self.end_time - self.start_time
        return None


@pytest.fixture
def performance_timer():
    """性能计时器fixture"""
    return PerformanceTimer()


