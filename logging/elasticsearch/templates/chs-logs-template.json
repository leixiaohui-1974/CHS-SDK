{
  "index_patterns": ["chs-*"],
  "version": 1,
  "settings": {
    "number_of_shards": 3,
    "number_of_replicas": 1,
    "index.refresh_interval": "30s",
    "index.codec": "best_compression",
    "index.mapping.total_fields.limit": 2000,
    "index.max_result_window": 50000,
    "analysis": {
      "analyzer": {
        "chs_log_analyzer": {
          "type": "custom",
          "tokenizer": "standard",
          "filter": [
            "lowercase",
            "stop",
            "snowball"
          ]
        },
        "chs_path_analyzer": {
          "type": "custom",
          "tokenizer": "path_hierarchy",
          "filter": [
            "lowercase"
          ]
        }
      },
      "tokenizer": {
        "path_hierarchy": {
          "type": "path_hierarchy",
          "delimiter": "/"
        }
      }
    }
  },
  "mappings": {
    "properties": {
      "@timestamp": {
        "type": "date",
        "format": "strict_date_optional_time||epoch_millis"
      },
      "@version": {
        "type": "keyword"
      },
      "message": {
        "type": "text",
        "analyzer": "chs_log_analyzer",
        "fields": {
          "keyword": {
            "type": "keyword",
            "ignore_above": 256
          }
        }
      },
      "log_level": {
        "type": "keyword"
      },
      "log_message": {
        "type": "text",
        "analyzer": "chs_log_analyzer",
        "fields": {
          "keyword": {
            "type": "keyword",
            "ignore_above": 512
          }
        }
      },
      "logger": {
        "type": "keyword"
      },
      "host": {
        "type": "keyword"
      },
      "source": {
        "type": "keyword"
      },
      "tags": {
        "type": "keyword"
      },
      "fields": {
        "properties": {
          "service": {
            "type": "keyword"
          },
          "environment": {
            "type": "keyword"
          },
          "log_type": {
            "type": "keyword"
          },
          "component": {
            "type": "keyword"
          }
        }
      },
      "request_id": {
        "type": "keyword"
      },
      "user_id": {
        "type": "keyword"
      },
      "simulation_id": {
        "type": "keyword"
      },
      "session_id": {
        "type": "keyword"
      },
      "client_ip": {
        "type": "ip"
      },
      "user_agent": {
        "type": "text",
        "fields": {
          "keyword": {
            "type": "keyword",
            "ignore_above": 256
          }
        }
      },
      "method": {
        "type": "keyword"
      },
      "endpoint": {
        "type": "keyword"
      },
      "request": {
        "type": "text",
        "analyzer": "chs_path_analyzer",
        "fields": {
          "keyword": {
            "type": "keyword",
            "ignore_above": 256
          }
        }
      },
      "status_code": {
        "type": "integer"
      },
      "response_time": {
        "type": "float"
      },
      "bytes": {
        "type": "long"
      },
      "referrer": {
        "type": "keyword",
        "ignore_above": 256
      },
      "http_version": {
        "type": "keyword"
      },
      "query_duration": {
        "type": "float"
      },
      "query_type": {
        "type": "keyword"
      },
      "pid": {
        "type": "integer"
      },
      "tid": {
        "type": "integer"
      },
      "connection_id": {
        "type": "long"
      },
      "role": {
        "type": "keyword"
      },
      "geoip": {
        "properties": {
          "location": {
            "type": "geo_point"
          },
          "country_name": {
            "type": "keyword"
          },
          "country_code2": {
            "type": "keyword"
          },
          "region_name": {
            "type": "keyword"
          },
          "city_name": {
            "type": "keyword"
          },
          "continent_code": {
            "type": "keyword"
          },
          "timezone": {
            "type": "keyword"
          }
        }
      },
      "kubernetes": {
        "properties": {
          "namespace": {
            "type": "keyword"
          },
          "pod": {
            "properties": {
              "name": {
                "type": "keyword"
              },
              "uid": {
                "type": "keyword"
              }
            }
          },
          "container": {
            "properties": {
              "name": {
                "type": "keyword"
              },
              "image": {
                "type": "keyword"
              }
            }
          },
          "node": {
            "properties": {
              "name": {
                "type": "keyword"
              }
            }
          },
          "labels": {
            "type": "object",
            "dynamic": true
          },
          "annotations": {
            "type": "object",
            "dynamic": true
          }
        }
      },
      "k8s_namespace": {
        "type": "keyword"
      },
      "k8s_pod": {
        "type": "keyword"
      },
      "k8s_container": {
        "type": "keyword"
      },
      "k8s_node": {
        "type": "keyword"
      },
      "error": {
        "properties": {
          "type": {
            "type": "keyword"
          },
          "message": {
            "type": "text",
            "analyzer": "chs_log_analyzer"
          },
          "stack_trace": {
            "type": "text",
            "index": false
          },
          "code": {
            "type": "keyword"
          }
        }
      },
      "performance": {
        "properties": {
          "cpu_usage": {
            "type": "float"
          },
          "memory_usage": {
            "type": "long"
          },
          "disk_usage": {
            "type": "float"
          },
          "network_io": {
            "type": "long"
          }
        }
      },
      "business": {
        "properties": {
          "operation": {
            "type": "keyword"
          },
          "entity_type": {
            "type": "keyword"
          },
          "entity_id": {
            "type": "keyword"
          },
          "result": {
            "type": "keyword"
          },
          "duration": {
            "type": "float"
          }
        }
      },
      "security": {
        "properties": {
          "event_type": {
            "type": "keyword"
          },
          "threat_level": {
            "type": "keyword"
          },
          "source_ip": {
            "type": "ip"
          },
          "target_ip": {
            "type": "ip"
          },
          "attack_type": {
            "type": "keyword"
          }
        }
      },
      "custom_fields": {
        "type": "object",
        "dynamic": true
      }
    }
  },
  "aliases": {
    "chs-logs-current": {},
    "chs-logs-all": {}
  }
}