# 阿里云部署环境变量配置
# 请根据实际情况修改这些值

# 应用配置
ENVIRONMENT=production
DEBUG=false
SECRET_KEY=your-production-secret-key-change-this

# 数据库配置
POSTGRES_DB=chs_simulation
POSTGRES_USER=chs_user
POSTGRES_PASSWORD=your-secure-postgres-password
POSTGRES_PORT=5432

# Redis配置
REDIS_PASSWORD=your-secure-redis-password
REDIS_PORT=6379

# API配置
API_PORT=8000
CORS_ORIGINS=https://your-domain.com,https://www.your-domain.com

# JWT配置
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# 文件上传配置
MAX_UPLOAD_SIZE=52428800
UPLOAD_DIR=/app/uploads

# 日志配置
LOG_LEVEL=INFO
LOG_FILE=/app/logs/app.log

# 性能配置
MAX_CONNECTIONS=200
POOL_SIZE=50

# WebSocket配置
WEBSOCKET_HEARTBEAT_INTERVAL=30
MAX_WEBSOCKET_CONNECTIONS=2000
WEBSOCKET_MONITOR_ENABLED=true

# 监控配置
MONITOR_INTERVAL=5
MAX_HISTORY_SIZE=2000

# 阿里云配置
ALIYUN_ACCESS_KEY_ID=your-aliyun-access-key-id
ALIYUN_ACCESS_KEY_SECRET=your-aliyun-access-key-secret
ALIYUN_REGION=cn-hangzhou

# 阿里云ECS配置
ALIYUN_ECS_INSTANCE_TYPE=ecs.c6.large
ALIYUN_ECS_IMAGE_ID=centos_8_4_x64_20G_alibase_20210824.vhd
ALIYUN_ECS_SECURITY_GROUP_ID=sg-xxxxxxxxxx
ALIYUN_ECS_VSWITCH_ID=vsw-xxxxxxxxxx

# 阿里云RDS配置
ALIYUN_RDS_INSTANCE_CLASS=rds.mysql.s2.large
ALIYUN_RDS_ENGINE=MySQL
ALIYUN_RDS_ENGINE_VERSION=8.0

# 阿里云SLB配置
ALIYUN_SLB_INSTANCE_SPEC=slb.s2.small
ALIYUN_SLB_INTERNET_CHARGE_TYPE=PayByTraffic

# 阿里云OSS配置
ALIYUN_OSS_BUCKET_NAME=chs-sdk-storage
ALIYUN_OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com

# 监控服务端口
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_USER=admin
GRAFANA_PASSWORD=your-secure-grafana-password

# 日志服务端口
ELASTICSEARCH_PORT=9200
LOGSTASH_PORT=5044
KIBANA_PORT=5601

# Nginx配置
HTTP_PORT=80
HTTPS_PORT=443

# SSL证书配置
SSL_CERT_PATH=/etc/nginx/ssl/cert.pem
SSL_KEY_PATH=/etc/nginx/ssl/key.pem