{
  "db_host": "localhost",
  "db_port": 5432,
  "db_name": "chs_simulation",
  "db_user": "chs_user",
  "db_password": "${DB_PASSWORD}",
  "backup_dir": "/app/backups/database",
  "retention_days": 30,
  "compression": true,
  "encryption": true,
  "encryption_key": "${BACKUP_ENCRYPTION_KEY}",
  "s3_bucket": "chs-backups",
  "s3_region": "us-west-2",
  "s3_access_key": "${AWS_ACCESS_KEY_ID}",
  "s3_secret_key": "${AWS_SECRET_ACCESS_KEY}",
  "notification_webhook": "${BACKUP_NOTIFICATION_WEBHOOK}"
}