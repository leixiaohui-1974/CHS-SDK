{
  "source_dirs": [
    "/app/uploads",
    "/app/simulation_results",
    "/app/user_data",
    "/app/logs"
  ],
  "backup_dir": "/app/backups/files",
  "retention_days": 90,
  "sync_interval": 3600,
  "exclude_patterns": [
    "*.tmp",
    "*.log",
    "*.cache",
    "*/.git/*",
    "*/node_modules/*",
    "*/__pycache__/*",
    "*.pyc",
    "*.pyo"
  ],
  "include_patterns": [
    "*.json",
    "*.yaml",
    "*.yml",
    "*.xml",
    "*.csv",
    "*.txt",
    "*.md",
    "*.pdf",
    "*.doc",
    "*.docx",
    "*.xls",
    "*.xlsx",
    "*.zip",
    "*.tar.gz",
    "*.sql",
    "*.py",
    "*.js",
    "*.ts",
    "*.html",
    "*.css",
    "*.vue",
    "*.jsx",
    "*.tsx"
  ],
  "max_file_size": 104857600,
  "compression": true,
  "encryption": true,
  "encryption_key": "${BACKUP_ENCRYPTION_KEY}",
  "s3_bucket": "chs-backups",
  "s3_region": "us-west-2",
  "s3_access_key": "${AWS_ACCESS_KEY_ID}",
  "s3_secret_key": "${AWS_SECRET_ACCESS_KEY}",
  "checksum_verification": true,
  "notification_webhook": "${BACKUP_NOTIFICATION_WEBHOOK}",
  "parallel_uploads": 4,
  "watch_mode": false
}