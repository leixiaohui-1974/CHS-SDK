            "type": "flow"
          },
          {
            "from": "canal2",
            "to": "gate2",
            "type": "flow"
          }
        ]
      }
    },
    "universal_config": {
      "simulation": {
        "name": "高级控制系统仿真",
        "description": "Example 1 - 高级控制系统，演示PID控制、模糊控制和自适应控制",
        "version": "1.0.0",
        "time": {
          "end_time": 1800.0,
          "time_step": 5.0,
          "output_interval": 25.0
        },
        "solver": {
          "method": "runge_kutta",
          "tolerance": "1e-8",
          "max_iterations": 2000
        },
        "parallel": {
          "enabled": true,
          "num_processes": 2
        }
      },
      "debug": {
        "enabled": true,
        "log_level": "DEBUG",
        "log_file": "logs/advanced_control/debug.log",
        "session_id": "advanced_control_session",
        "data_collection": {
          "enabled": true,
          "interval": 25.0,
          "variables": [
            "upstream_canal_water_level",
            "downstream_canal_water_level",
            "control_gate_opening",
            "inflow_rate",
            "outflow_rate",
            "pid_output",
            "control_error",
            "setpoint",
            "fuzzy_output",
            "adaptive_gain"
          ]
        },
        "dashboard": {
          "web_dashboard": true,
          "port": 8082,
          "auto_open": false
        },
        "console": {
          "real_time_display": true,
          "update_interval": 5.0
        }
      },
      "performance": {
        "enabled": true,
        "timing": {
          "enabled": true,
          "detailed_profiling": true
        },
        "memory": {
          "enabled": true,
          "threshold_mb": 1500
        },
        "cpu": {
          "enabled": true,
          "threshold_percent": 85
        }
      },
      "visualization": {
        "enabled": true,
        "plots": {
          "enabled": true,
          "save_plots": true,
          "plot_directory": "plots/advanced_control/",
          "format": "png",
          "dpi": 300,
          "charts": [
            {
              "name": "控制系统响应",
              "type": "time_series",
              "variables": [
                "setpoint",
                "upstream_canal_water_level",
                "control_error"
              ],
              "title": "Control System Response",
              "xlabel": "Time (s)",
              "ylabel": "Water Level (m)"
            },
            {
              "name": "控制器输出",
              "type": "time_series",
              "variables": [
                "pid_output",
                "fuzzy_output",
                "control_gate_opening"
              ],
              "title": "Controller Outputs",
              "xlabel": "Time (s)",
              "ylabel": "Control Signal"
            },
            {
              "name": "自适应参数",
              "type": "time_series",
              "variables": [
                "adaptive_gain"
              ],
              "title": "Adaptive Control Parameters",
              "xlabel": "Time (s)",
              "ylabel": "Gain Value"
            },
            {
              "name": "控制性能分析",
              "type": "control_performance",
              "variables": [
                "control_error",
                "setpoint",
                "upstream_canal_water_level"
              ],
              "title": "Control Performance Analysis"
            }
          ]
        },
        "dashboard": {
          "enabled": true,
          "update_interval": 2.0,
          "port": 8083
        }
      },
      "output": {
        "enabled": true,
        "output_directory": "results/advanced_control/",
        "save_history": true,
        "history_file": "simulation_history.json",
        "format": {
          "csv": true,
          "json": true,
          "hdf5": true
        },
        "compression": {
          "enabled": true,
          "method": "gzip"
        },
        "validation": {
          "enabled": true,
          "expected_results": {
            "settling_time": 300.0,
            "overshoot": 0.1,
            "steady_state_error": 0.02
          },
          "tolerance": 0.05
        }
      },
      "analysis": {
        "enabled": true,
        "control_performance": {
          "enabled": true,
          "metrics": [
            "settling_time",
            "overshoot",
            "steady_state_error",
            "rise_time",
            "peak_time"
          ],
          "reference_signal": "setpoint",
          "output_signal": "upstream_canal_water_level"
        },
        "statistical": {
          "enabled": true,
          "generate_summary": true,
          "correlation_analysis": true
        },
        "system_identification": {
          "enabled": true,
          "method": "arx",
          "order": [
            3,
            3,
            2
          ],
          "input_signals": [
            "control_gate_opening"
          ],
          "output_signals": [
            "upstream_canal_water_level"
          ]
        },
        "frequency_analysis": {
          "enabled": true,
          "fft_analysis": true,
          "bode_plot": true
        }
      },
      "logging": {
        "enabled": true,
        "level": "DEBUG",
        "file": {
          "enabled": true,
          "filename": "logs/advanced_control/simulation.log",
          "max_size_mb": 20,
          "backup_count": 10
        },
        "console": {
          "enabled": true,
          "format": "%(asctime)s - %(name)s - %(levelname)s - %(message)s"
        },
        "structured": {
          "enabled": true,
          "format": "json"
        },
        "control_log": {
          "enabled": true,
          "filename": "logs/advanced_control/control.log",
          "variables": [
            "pid_output",
            "control_error",
            "setpoint"
          ]
        }
      },
      "error_handling": {
        "enabled": true,
        "categories": {
          "critical": [
            "control_instability",
            "actuator_failure",
            "sensor_failure"
          ],
          "warning": [
            "control_saturation",
            "slow_response",
            "oscillation"
          ],
          "info": [
            "setpoint_change",
            "parameter_update",
            "mode_switch"
          ]
        },
        "recovery": {
          "auto_retry": true,
          "max_retries": 5,
          "retry_delay": 2.0,
          "fallback_controller": "manual"
        },
        "notifications": {
          "enabled": true,
          "email": [
            "control_engineer@example.com"
          ],
          "webhook": "http://localhost:9000/alerts"
        }
      },
      "cache": {
        "enabled": true,
        "memory": {
          "enabled": true,
          "max_size_mb": 200
        },
        "disk": {
          "enabled": true,
          "directory": "cache/advanced_control/",
          "max_size_gb": 2
        }
      },
      "network": {
        "enabled": false,
        "distributed": {
          "enabled": false,
          "master_host": "localhost",
          "master_port": 9001
        },
        "communication": {
          "protocol": "tcp",
          "timeout": 30,
          "buffer_size": 16384
        }
      },
      "security": {
        "enabled": false,
        "access_control": {
          "enabled": false,
          "allowed_hosts": [
            "localhost"
          ]
        },
        "encryption": {
          "enabled": false,
          "algorithm": "AES-256"
        }
      },
      "extensions": {
        "enabled": true,
        "plugins": {
          "enabled": true,
          "directory": "plugins/control/",
          "modules": [
            "fuzzy_controller",
            "adaptive_controller"
          ]
        },
        "custom": {
          "enabled": true,
          "modules": [
            "advanced_pid",
            "model_predictive_control"
          ]
        }
      },
      "environment": {
        "name": "development",
        "variables": {
          "SIMULATION_ENV": "advanced_control",
          "LOG_LEVEL": "DEBUG",
          "CONTROL_MODE": "advanced"
        },
        "custom_vars": {
          "pid_kp": 2.0,
          "pid_ki": 0.5,
          "pid_kd": 0.1,
