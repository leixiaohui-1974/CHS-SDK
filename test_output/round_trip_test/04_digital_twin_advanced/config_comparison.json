    "universal_config": {
      "simulation": {
        "name": "高级数字孪生仿真",
        "description": "Example 1 - 高级数字孪生系统，演示数据平滑、状态估计和预测分析",
        "version": "1.0.0",
        "time": {
          "end_time": 30.0,
          "time_step": 1.0,
          "output_interval": 5.0
        },
        "solver": {
          "method": "euler",
          "tolerance": "1e-6",
          "max_iterations": 1000
        },
        "parallel": {
          "enabled": true,
          "num_processes": 2
        }
      },
      "debug": {
        "enabled": true,
        "log_level": "INFO",
        "log_file": "logs/digital_twin_advanced/debug.log",
        "session_id": "digital_twin_advanced_session",
        "data_collection": {
          "enabled": true,
          "interval": 5.0,
          "variables": [
            "true_water_level",
            "noisy_water_level",
            "smoothed_water_level",
            "estimated_state",
            "prediction_error",
            "noise_variance",
            "smoothing_factor",
            "kalman_gain",
            "state_covariance"
          ]
        },
        "dashboard": {
          "web_dashboard": true,
          "port": 8086,
          "auto_open": false
        },
        "console": {
          "real_time_display": true,
          "update_interval": 1.0
        }
      },
      "performance": {
        "enabled": true,
        "timing": {
          "enabled": true,
          "detailed_profiling": true,
          "digital_twin_timing": true
        },
        "memory": {
          "enabled": true,
          "threshold_mb": 1200
        },
        "cpu": {
          "enabled": true,
          "threshold_percent": 75
        }
      },
      "visualization": {
        "enabled": true,
        "plots": {
          "enabled": true,
          "save_plots": true,
          "plot_directory": "plots/digital_twin_advanced/",
          "format": "png",
          "dpi": 300,
          "charts": [
            {
              "name": "数据平滑效果",
              "type": "time_series",
              "variables": [
                "true_water_level",
                "noisy_water_level",
                "smoothed_water_level"
              ],
              "title": "Data Smoothing Effectiveness",
              "xlabel": "Time (s)",
              "ylabel": "Water Level (m)"
            },
            {
              "name": "状态估计性能",
              "type": "time_series",
              "variables": [
                "true_water_level",
                "estimated_state",
                "prediction_error"
              ],
              "title": "State Estimation Performance",
              "xlabel": "Time (s)",
              "ylabel": "Level/Error (m)"
            },
            {
              "name": "噪声分析",
              "type": "time_series",
              "variables": [
                "noise_variance",
                "smoothing_factor"
              ],
              "title": "Noise Analysis and Smoothing",
              "xlabel": "Time (s)",
              "ylabel": "Variance/Factor"
            },
            {
              "name": "卡尔曼滤波参数",
              "type": "time_series",
              "variables": [
                "kalman_gain",
                "state_covariance"
              ],
              "title": "Kalman Filter Parameters",
              "xlabel": "Time (s)",
              "ylabel": "Gain/Covariance"
