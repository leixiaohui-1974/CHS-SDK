{
  "original_config": {
    "agents": {
      "agents": [
        {
          "id": "digital_twin_agent",
          "class": "core_lib.local_agents.perception.digital_twin_agent.DigitalTwinAgent",
          "agent_id": "twin_agent_1",
          "simulated_object_id": "upstream_canal",
          "state_topic": "state/canal/level/smoothed",
          "log_data": true,
          "smoothing_config": {
            "water_level": 0.3
          }
        }
      ]
    },
    "components": {
      "components": [
        {
          "id": "upstream_canal",
          "class": "UnifiedCanal",
          "model_type": "integral",
          "initial_state": {
            "water_level": 10.0
          },
          "parameters": {
            "bottom_width": 20.0,
            "length": 1000.0,
            "slope": 0.001,
            "side_slope_z": 2.0,
            "manning_n": 0.025,
            "surface_area": 20000,
            "outlet_coefficient": 5.0
          }
        }
      ]
    },
    "config": {
      "simulation": {
        "duration": 30,
        "time_step": 1.0,
        "description": "DigitalTwinAgent data smoothing demonstration"
      },
      "communication": {
        "smoothed_state_topic": "state/canal/level/smoothed"
      },
      "data_generation": {
        "noise_injection": true,
        "noise_type": "gaussian",
        "noise_parameters": {
          "mean": 0.0,
          "std": 0.5
        }
      },
      "analysis": {
        "enable_validation": true,
        "variance_comparison": true,
        "true_water_level": 10.0,
        "noise_std": 0.5
      }
    },
