          ],
          "output_signals": [
            "upstream_canal_water_level"
          ]
        },
        "fault_analysis": {
          "enabled": true,
          "fault_detection": true,
          "fault_diagnosis": true,
          "fault_prognosis": true,
          "mtbf_analysis": true,
          "mttr_analysis": true
        }
      },
      "logging": {
        "enabled": true,
        "level": "DEBUG",
        "file": {
          "enabled": true,
          "filename": "logs/fault_tolerance/simulation.log",
          "max_size_mb": 50,
          "backup_count": 20
        },
        "console": {
          "enabled": true,
          "format": "%(asctime)s - %(name)s - %(levelname)s - %(message)s"
        },
        "structured": {
          "enabled": true,
          "format": "json"
        },
        "fault_log": {
          "enabled": true,
          "filename": "logs/fault_tolerance/fault.log",
          "variables": [
            "fault_status",
            "fault_type",
            "fault_severity",
            "recovery_action"
          ]
        },
        "safety_log": {
          "enabled": true,
          "filename": "logs/fault_tolerance/safety.log",
