      }
    },
    "universal_config": {
      "simulation": {
        "name": "容错系统仿真",
        "description": "Example 1 - 容错系统，演示故障检测、诊断和容错控制",
        "version": "1.0.0",
        "time": {
          "end_time": 2400.0,
          "time_step": 2.0,
          "output_interval": 20.0
        },
        "solver": {
          "method": "runge_kutta",
          "tolerance": "1e-9",
          "max_iterations": 3000
        },
        "parallel": {
          "enabled": true,
          "num_processes": 4
        }
      },
      "debug": {
        "enabled": true,
        "log_level": "DEBUG",
        "log_file": "logs/fault_tolerance/debug.log",
        "session_id": "fault_tolerance_session",
        "data_collection": {
          "enabled": true,
          "interval": 20.0,
          "variables": [
            "upstream_canal_water_level",
            "downstream_canal_water_level",
            "control_gate_opening",
            "inflow_rate",
            "outflow_rate",
            "pid_output",
            "control_error",
            "setpoint",
            "fault_status",
            "fault_type",
            "fault_severity",
            "recovery_action",
            "system_health",
            "sensor_status",
            "actuator_status"
          ]
        },
        "dashboard": {
          "web_dashboard": true,
          "port": 8084,
          "auto_open": false
        },
        "console": {
          "real_time_display": true,
          "update_interval": 2.0
        }
      },
      "performance": {
        "enabled": true,
        "timing": {
          "enabled": true,
          "detailed_profiling": true,
          "fault_detection_timing": true
        },
        "memory": {
          "enabled": true,
          "threshold_mb": 2000
        },
        "cpu": {
          "enabled": true,
          "threshold_percent": 90
        }
      },
      "visualization": {
        "enabled": true,
        "plots": {
          "enabled": true,
          "save_plots": true,
          "plot_directory": "plots/fault_tolerance/",
          "format": "png",
          "dpi": 300,
          "charts": [
            {
              "name": "系统健康状态",
              "type": "time_series",
              "variables": [
                "system_health",
                "fault_status"
              ],
              "title": "System Health and Fault Status",
              "xlabel": "Time (s)",
              "ylabel": "Status"
            },
            {
              "name": "故障检测与恢复",
              "type": "time_series",
              "variables": [
                "fault_severity",
                "recovery_action"
              ],
              "title": "Fault Detection and Recovery",
              "xlabel": "Time (s)",
              "ylabel": "Severity/Action"
            },
            {
              "name": "传感器状态",
              "type": "time_series",
              "variables": [
                "sensor_status"
              ],
              "title": "Sensor Status Monitoring",
              "xlabel": "Time (s)",
              "ylabel": "Status"
            },
            {
              "name": "执行器状态",
              "type": "time_series",
              "variables": [
                "actuator_status"
              ],
              "title": "Actuator Status Monitoring",
              "xlabel": "Time (s)",
              "ylabel": "Status"
            },
            {
              "name": "容错控制性能",
              "type": "control_performance",
              "variables": [
                "control_error",
                "setpoint",
                "upstream_canal_water_level"
              ],
              "title": "Fault-Tolerant Control Performance"
            }
          ]
        },
        "dashboard": {
          "enabled": true,
          "update_interval": 1.0,
          "port": 8085
        }
      },
      "output": {
        "enabled": true,
        "output_directory": "results/fault_tolerance/",
        "save_history": true,
        "history_file": "simulation_history.json",
        "format": {
          "csv": true,
          "json": true,
          "hdf5": true
        },
        "compression": {
          "enabled": true,
          "method": "gzip"
        },
        "validation": {
          "enabled": true,
          "expected_results": {
            "fault_detection_time": 10.0,
            "recovery_time": 30.0,
            "system_availability": 0.95
          },
          "tolerance": 0.1
        }
      },
      "analysis": {
        "enabled": true,
        "control_performance": {
          "enabled": true,
          "metrics": [
            "settling_time",
            "overshoot",
            "steady_state_error",
            "fault_tolerance"
          ],
          "reference_signal": "setpoint",
          "output_signal": "upstream_canal_water_level"
        },
        "statistical": {
          "enabled": true,
          "generate_summary": true,
          "fault_statistics": true
        },
        "system_identification": {
          "enabled": true,
          "method": "arx",
          "order": [
