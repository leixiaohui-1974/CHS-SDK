            "surface_area": 10000.0,
            "max_capacity": 200000.0,
            "min_level": 5.0,
            "max_level": 25.0
          }
        },
        {
          "id": "gate1",
          "class": "Gate",
          "initial_state": {
            "opening": 0.3
          },
          "parameters": {
            "discharge_coefficient": 0.8,
            "width": 8.0,
            "max_opening": 2.5
