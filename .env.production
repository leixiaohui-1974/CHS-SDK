# CHS Simulation Platform - Production Environment Configuration
# IMPORTANT: Update all default values before deploying to production!

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================
ENVIRONMENT=production
DEBUG=false
# CRITICAL: Change this to a secure random key in production!
SECRET_KEY=CHANGE-THIS-TO-A-SECURE-RANDOM-KEY-IN-PRODUCTION-AT-LEAST-32-CHARS
API_PORT=8000
HTTP_PORT=80
HTTPS_PORT=443

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# CRITICAL: Update these with your production database credentials!
POSTGRES_DB=chs_simulation_prod
POSTGRES_USER=chs_prod_user
POSTGRES_PASSWORD=CHANGE-THIS-TO-A-SECURE-PASSWORD
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://chs_prod_user:CHANGE-THIS-TO-A-SECURE-PASSWORD@postgres:5432/chs_simulation_prod

# Database Pool Settings (Production Optimized)
POOL_SIZE=50
MAX_OVERFLOW=100
POOL_TIMEOUT=30
POOL_RECYCLE=3600

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================
# CRITICAL: Update with secure Redis password!
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE-THIS-TO-A-SECURE-REDIS-PASSWORD
REDIS_DB=0
REDIS_URL=redis://:CHANGE-THIS-TO-A-SECURE-REDIS-PASSWORD@redis:6379/0

# Redis Pool Settings (Production Optimized)
REDIS_MAX_CONNECTIONS=200
REDIS_RETRY_ON_TIMEOUT=true
REDIS_SOCKET_TIMEOUT=10
REDIS_SOCKET_CONNECT_TIMEOUT=10

# =============================================================================
# CORS CONFIGURATION
# =============================================================================
# CRITICAL: Update with your production domain!
CORS_ORIGINS=https://your-production-domain.com,https://api.your-domain.com
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=GET,POST,PUT,DELETE,OPTIONS,PATCH
CORS_ALLOW_HEADERS=*

# =============================================================================
# JWT CONFIGURATION
# =============================================================================
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# =============================================================================
# FILE UPLOAD CONFIGURATION
# =============================================================================
MAX_UPLOAD_SIZE=52428800
UPLOAD_DIR=/app/uploads
ALLOWED_EXTENSIONS=.txt,.csv,.json,.xml,.pdf,.doc,.docx,.xls,.xlsx

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================
LOG_LEVEL=WARNING
LOG_FILE=/app/logs/app.log
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s
LOG_MAX_SIZE=104857600
LOG_BACKUP_COUNT=10

# =============================================================================
# PERFORMANCE CONFIGURATION
# =============================================================================
MAX_CONNECTIONS=500
POOL_SIZE=50
WORKERS=8
KEEP_ALIVE=5
TIMEOUT=60

# =============================================================================
# WEBSOCKET CONFIGURATION
# =============================================================================
WEBSOCKET_HEARTBEAT_INTERVAL=30
MAX_WEBSOCKET_CONNECTIONS=5000
WEBSOCKET_TIMEOUT=120

# =============================================================================
# MONITORING CONFIGURATION
# =============================================================================
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
# CRITICAL: Change default Grafana credentials!
GRAFANA_USER=admin
GRAFANA_PASSWORD=CHANGE-THIS-TO-A-SECURE-GRAFANA-PASSWORD

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_BURST=20
SESSION_TIMEOUT=1800
PASSWORD_MIN_LENGTH=12

# =============================================================================
# CACHE CONFIGURATION
# =============================================================================
CACHE_TTL=7200
CACHE_MAX_SIZE=10000
CACHE_ENABLED=true

# =============================================================================
# EMAIL CONFIGURATION
# =============================================================================
# CRITICAL: Configure with your production SMTP settings!
SMTP_HOST=your-smtp-server.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_TLS=true
FROM_EMAIL=noreply@your-production-domain.com

# =============================================================================
# SSL/TLS CONFIGURATION
# =============================================================================
SSL_CERT_PATH=/etc/nginx/ssl/cert.pem
SSL_KEY_PATH=/etc/nginx/ssl/key.pem
SSL_REDIRECT=true

# =============================================================================
# BACKUP CONFIGURATION
# =============================================================================
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_S3_BUCKET=your-backup-bucket
BACKUP_S3_REGION=us-east-1

# =============================================================================
# EXTERNAL SERVICES
# =============================================================================
# Add your external service configurations here
# AWS_ACCESS_KEY_ID=your-aws-access-key
# AWS_SECRET_ACCESS_KEY=your-aws-secret-key
# SENTRY_DSN=your-sentry-dsn