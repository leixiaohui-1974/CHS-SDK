  "shortcuts": [
    {
      "name": "新建仿真",
      "short_name": "新建",
      "description": "快速创建新的仿真项目",
      "url": "/simulation/new",
      "icons": [
        {
          "src": "/icons/shortcut-new.png",
          "sizes": "96x96"
        }
      ]
    },
    {
      "name": "仿真历史",
      "short_name": "历史",
      "description": "查看仿真历史记录",
      "url": "/simulation/history",
      "icons": [
        {
          "src": "/icons/shortcut-history.png",
          "sizes": "96x96"
        }
      ]
    },
    {
      "name": "批量仿真",
      "short_name": "批量",
      "description": "执行批量仿真任务",
      "url": "/batch",
      "icons": [
        {
          "src": "/icons/shortcut-batch.png",
          "sizes": "96x96"
        }
      ]
    },
    {
      "name": "数据分析",
      "short_name": "分析",
      "description": "查看和分析仿真结果",
      "url": "/analysis",
      "icons": [
        {
          "src": "/icons/shortcut-analysis.png",
          "sizes": "96x96"
        }
      ]
    }
  ],
  "related_applications": [
    {
      "platform": "webapp",
      "url": "https://chs-simulation.com/"
    }
  ],
  "prefer_related_applications": false,
  "edge_side_panel": {
    "preferred_width": 400
  },
  "launch_handler": {
    "client_mode": "navigate-existing"
  },
  "handle_links": "preferred",
  "capture_links": "existing-client-navigate",
  "protocol_handlers": [
    {
      "protocol": "web+chs",
      "url": "/open?url=%s"
    }
  ],
  "file_handlers": [
    {
      "action": "/open",
      "accept": {
        "application/json": [".chs", ".json"],
        "text/csv": [".csv"],
        "application/vnd.ms-excel": [".xlsx"]
      }
    }
  ]
}