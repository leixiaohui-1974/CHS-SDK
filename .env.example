# CHS Simulation Platform Environment Configuration
# Copy this file to .env and update the values for your environment

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=your-secret-key-change-in-production-must-be-at-least-32-characters
API_PORT=8000
HTTP_PORT=80
HTTPS_PORT=443

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
POSTGRES_DB=chs_simulation
POSTGRES_USER=chs_user
POSTGRES_PASSWORD=chs_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://chs_user:chs_password@localhost:5432/chs_simulation

# Database Pool Settings
POOL_SIZE=20
MAX_OVERFLOW=30
POOL_TIMEOUT=30
POOL_RECYCLE=3600

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=chs_redis_password
REDIS_DB=0
REDIS_URL=redis://:chs_redis_password@localhost:6379/0

# Redis Pool Settings
REDIS_MAX_CONNECTIONS=100
REDIS_RETRY_ON_TIMEOUT=true
REDIS_SOCKET_TIMEOUT=5
REDIS_SOCKET_CONNECT_TIMEOUT=5

# =============================================================================
# CORS CONFIGURATION
# =============================================================================
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080,http://localhost:8000
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=GET,POST,PUT,DELETE,OPTIONS,PATCH
CORS_ALLOW_HEADERS=*

# =============================================================================
# JWT AUTHENTICATION
# =============================================================================
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_RESET_TOKEN_EXPIRE_HOURS=1

# =============================================================================
# FILE UPLOAD SETTINGS
# =============================================================================
MAX_UPLOAD_SIZE=10485760
UPLOAD_DIR=./uploads
ALLOWED_EXTENSIONS=.json,.csv,.xlsx,.txt,.zip
MAX_FILES_PER_REQUEST=10

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================
LOG_LEVEL=INFO
LOG_FILE=./logs/app.log
LOG_MAX_SIZE=10485760
LOG_BACKUP_COUNT=5
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

# =============================================================================
# WEBSOCKET SETTINGS
# =============================================================================
WEBSOCKET_HEARTBEAT_INTERVAL=30
MAX_WEBSOCKET_CONNECTIONS=1000
WEBSOCKET_MESSAGE_MAX_SIZE=1048576
WEBSOCKET_TIMEOUT=60

# =============================================================================
# SIMULATION SETTINGS
# =============================================================================
MAX_SIMULATION_DURATION=3600
MAX_CONCURRENT_SIMULATIONS=10
SIMULATION_STEP_INTERVAL=1.0
SIMULATION_DATA_RETENTION_DAYS=30
MAX_SIMULATION_COMPONENTS=1000

# =============================================================================
# PERFORMANCE SETTINGS
# =============================================================================
MAX_CONNECTIONS=100
WORKER_PROCESSES=4
WORKER_CONNECTIONS=1000
KEEPALIVE_TIMEOUT=5
REQUEST_TIMEOUT=30

# Rate Limiting
RATE_LIMIT_REQUESTS=1000
RATE_LIMIT_WINDOW=3600
AUTH_RATE_LIMIT_REQUESTS=10
AUTH_RATE_LIMIT_WINDOW=300

# =============================================================================
# MONITORING SETTINGS
# =============================================================================
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# Health Check
HEALTH_CHECK_INTERVAL=30
HEALTH_CHECK_TIMEOUT=10
HEALTH_CHECK_RETRIES=3

# =============================================================================
# LOGGING STACK (ELK)
# =============================================================================
ELASTICSEARCH_PORT=9200
LOGSTASH_PORT=5044
KIBANA_PORT=5601
ELASTICSEARCH_HEAP_SIZE=512m

# =============================================================================
# SECURITY SETTINGS
# =============================================================================
# SSL/TLS
SSL_ENABLED=false
SSL_CERT_PATH=./ssl/cert.pem
SSL_KEY_PATH=./ssl/key.pem

# Security Headers
SECURE_HEADERS_ENABLED=true
HSTS_MAX_AGE=31536000
CSP_POLICY=default-src 'self'

# Session Security
SESSION_SECURE=false
SESSION_HTTPONLY=true
SESSION_SAMESITE=lax

# =============================================================================
# EMAIL SETTINGS (Optional)
# =============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_TLS=true
SMTP_SSL=false
EMAIL_FROM=noreply@chssimulation.com
EMAIL_FROM_NAME=CHS Simulation Platform

# =============================================================================
# BACKUP SETTINGS
# =============================================================================
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_STORAGE_PATH=./backups

# =============================================================================
# DEVELOPMENT SETTINGS
# =============================================================================
# Hot Reload
HOT_RELOAD=true
AUTO_RELOAD=true

# Debug Tools
DEBUG_TOOLBAR=false
PROFILING_ENABLED=false

# Testing
TEST_DATABASE_URL=postgresql://chs_user:chs_password@localhost:5432/chs_simulation_test
TEST_REDIS_URL=redis://:chs_redis_password@localhost:6379/1

# =============================================================================
# PRODUCTION OVERRIDES
# =============================================================================
# Uncomment and modify these for production deployment

# ENVIRONMENT=production
# DEBUG=false
# SECRET_KEY=your-production-secret-key-minimum-32-characters-long
# JWT_SECRET_KEY=your-production-jwt-secret-key
# POSTGRES_PASSWORD=your-secure-database-password
# REDIS_PASSWORD=your-secure-redis-password
# SSL_ENABLED=true
# SESSION_SECURE=true
# CORS_ORIGINS=https://yourdomain.com
# LOG_LEVEL=WARNING
# WORKER_PROCESSES=8
# MAX_CONNECTIONS=200